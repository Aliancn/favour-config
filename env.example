# Copy this file to ~/.config/favour-config/env and fill in the values you need.
# Never commit the real file. Existing environment variables take precedence.
#
#   mkdir -p ~/.config/favour-config
#   cp env.example ~/.config/favour-config/env
#   chmod 600 ~/.config/favour-config/env

# paper-reader: MinerU Cloud API token
MINERU_TOKEN=

# wxmp-article-harvester (optional): paid Metaso full-text fallback
METASO_API_KEY=

# wxmp-article-harvester (optional): override export/profile directory
# WXMP_HARVEST_HOME=

# xuecheng / md2citadel: internal document platform
KM_BASE_URL=
CITADEL_CONVERT_URL=
DOC_SSO_URL=
OA_SKILLS_NPM_REGISTRY=
